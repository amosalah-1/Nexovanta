{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/supabase-config.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/supabase-config.js",
      "dest": "/api/supabase-config.js"
    },
    {
      "handle": "filesystem"
    }
  ]
}
