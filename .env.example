# Nexovanta local environment example
# Copy this to .env and fill with your Supabase project settings.
# DO NOT commit your .env with real keys to version control.

# Supabase project base URL (example: https://your-project.supabase.co)
# Use the project base URL — remove any trailing /rest/v1 or trailing slash.
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (browser-safe). Do NOT use a service role key here.
SUPABASE_ANON_KEY=your-anon-public-key

# Optional: if you use Vite or other prefixes in your local dev, uncomment
# VITE_SUPABASE_URL=$SUPABASE_URL
# VITE_SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY

# Notes:
# - After creating .env, restart the dev server (npm start) so server-side API
#   (api/supabase-config.js) reads the variables.
# - For production on Vercel, set SUPABASE_URL and SUPABASE_ANON_KEY in the
#   Project Settings -> Environment Variables. Do not store secrets in the
#   repository.
